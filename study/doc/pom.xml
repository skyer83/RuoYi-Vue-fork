<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.ruoyi</groupId>
        <artifactId>ruoyi</artifactId>
        <version>3.9.2</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>doc</artifactId>

    <name>Maven</name>
    <url>http://maven.apache.org/</url>
    <inceptionYear>2001</inceptionYear>

    <distributionManagement>
        <site>
            <id>website</id>
            <url>scp://webhost.company.com/www/website</url>
        </site>
    </distributionManagement>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <build>
        <plugins>
            <!-- Maven Site 插件（基础） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-site-plugin</artifactId>
                <version>3.12.1</version>
                <configuration>
                    <!-- 支持的语言：中文（zh）、英文（默认）、法文（fr） -->
                    <locales>en,fr</locales>
                    <!-- 注意：defaultLocale 和 skin 参数在 3.12.1 已移除，默认使用 locales 第一个语言 -->
                </configuration>
                <dependencies>
                    <!-- 支持 Markdown 格式 -->
                    <dependency>
                        <groupId>org.apache.maven.doxia</groupId>
                        <artifactId>doxia-module-markdown</artifactId>
                        <version>1.12.0</version>
                    </dependency>
                </dependencies>
            </plugin>

            <!--
                在 site 构建后注入 CSS 和 JavaScript
            -->
            <plugin>
                <groupId>com.google.code.maven-replacer-plugin</groupId>
                <artifactId>replacer</artifactId>
                <version>1.5.3</version>
                <executions>
                    <!-- 子目录 HTML 文件（先执行） -->
                    <execution>
                        <id>add-search-styles-subdir</id>
                        <phase>site</phase>
                        <goals>
                            <goal>replace</goal>
                        </goals>
                        <configuration>
                            <basedir>${project.build.directory}/site</basedir>
                            <includes>
                                <include>*/*.html</include>
                                <include>*/*/*.html</include>
                            </includes>
                            <replacements>
                                <replacement>
                                    <token><![CDATA[</head>]]></token>
                                    <value><![CDATA[<link rel="stylesheet" href="../css/search.css" />
</head>]]></value>
                                </replacement>
                            </replacements>
                        </configuration>
                    </execution>
                    <execution>
                        <id>add-minisearch-subdir</id>
                        <phase>site</phase>
                        <goals>
                            <goal>replace</goal>
                        </goals>
                        <configuration>
                            <basedir>${project.build.directory}/site</basedir>
                            <includes>
                                <include>*/*.html</include>
                                <include>*/*/*.html</include>
                            </includes>
                            <replacements>
                                <replacement>
                                    <token><![CDATA[</body>]]></token>
                                    <value><![CDATA[<script src="https://cdn.jsdelivr.net/npm/minisearch@6.3.0/dist/umd/index.min.js"></script>
<script src="../js/site-enhancements.js"></script></body>]]></value>
                                </replacement>
                            </replacements>
                        </configuration>
                    </execution>
                    <!-- 根目录 HTML 文件（后执行） -->
                    <execution>
                        <id>add-search-styles-root</id>
                        <phase>site</phase>
                        <goals>
                            <goal>replace</goal>
                        </goals>
                        <configuration>
                            <basedir>${project.build.directory}/site</basedir>
                            <includes>
                                <include>*.html</include>
                            </includes>
                            <replacements>
                                <replacement>
                                    <token><![CDATA[</head>]]></token>
                                    <value><![CDATA[<link rel="stylesheet" href="./css/search.css" />
</head>]]></value>
                                </replacement>
                            </replacements>
                        </configuration>
                    </execution>
                    <execution>
                        <id>add-minisearch-root</id>
                        <phase>site</phase>
                        <goals>
                            <goal>replace</goal>
                        </goals>
                        <configuration>
                            <basedir>${project.build.directory}/site</basedir>
                            <includes>
                                <include>*.html</include>
                            </includes>
                            <replacements>
                                <replacement>
                                    <token><![CDATA[</body>]]></token>
                                    <value><![CDATA[<script src="https://cdn.jsdelivr.net/npm/minisearch@6.3.0/dist/umd/index.min.js"></script>
<script src="./js/site-enhancements.js"></script></body>]]></value>
                                </replacement>
                            </replacements>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
